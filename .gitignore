*~

# Local Git worktrees (managed separately, never cleaned as build output)
.worktrees/

# Retired reference/experiment output; current assets live under native/assets
/legacy/
/vibe_images/
参考图/
docs/prototypes/**/.edge-profile/

# Private environment and OS files
.env
.env.local
.env.*.local
.DS_Store
Thumbs.db

# Windows '> NUL' typo under Git Bash
NUL

# Local GraphFlow index cache
.graphflow-cache/
/graphflow-out/

# Unexpanded workspace directory created by local tooling
/[$][{]CODEX_PROJECT_DIR*/

